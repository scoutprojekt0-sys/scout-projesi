FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 82 www-data \
    && useradd -u 82 -g 82 -M -s /usr/sbin/nologin www-data

COPY ai-worker/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY ai-worker/app ./app
COPY ai-worker/models ./models
COPY ai-worker/datasets ./datasets
COPY ai-worker/scripts ./scripts
COPY ai-worker/yolov8n.pt ./yolov8n.pt

RUN mkdir -p /app/raw_videos /app/datasets \
    && chown -R www-data:www-data /app/raw_videos /app/datasets

USER www-data

EXPOSE 8010

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
